# ─────────────────────────────────────────────────────────────────────────────
# Ambiente de PRODUÇÃO — copie para `.env` no servidor, ao lado do compose.yml.
#
# Este arquivo nunca sai do servidor. Não existe no repositório com valores
# reais, não vai para dentro da imagem (ver .dockerignore) e não passa pelo CI.
# ─────────────────────────────────────────────────────────────────────────────

# ── Imagens e versão ─────────────────────────────────────────────────────────
# Preenchidos com o seu usuário/organização do GitHub, em minúsculas.
IMAGE_API=ghcr.io/SEU-USUARIO/normatiza-api
IMAGE_WEB=ghcr.io/SEU-USUARIO/normatiza-web

# A versão no ar. O deploy reescreve esta linha com o SHA do commit, e é isso
# que torna o rollback trivial: troque o valor por um SHA antigo e suba de novo.
TAG=latest

# Porta local onde o Cloudflare Tunnel encontra o site.
HOST_PORT=8080

# ── Banco (Neon) ─────────────────────────────────────────────────────────────
# Duas URLs para o MESMO banco, e a diferença entre elas é o sufixo `-pooler`
# no host. Não é redundância:
#
#   DATABASE_URL  → endpoint com pooler. É o que a aplicação usa, e o que
#                   aguenta muitas conexões curtas.
#   DIRECT_URL    → endpoint direto, sem pgbouncer. É o que as MIGRAÇÕES usam:
#                   o pooler em modo transaction não sustenta os advisory locks
#                   do Prisma, e a migração trava por lá.
#
# Copie a mesma string nas duas linhas e apague o `-pooler` da segunda.
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxxx-pooler.REGIAO.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://USUARIO:SENHA@ep-xxxxx.REGIAO.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ── Sessão ───────────────────────────────────────────────────────────────────
# Gere UM DE CADA, diferentes entre si e diferentes dos de desenvolvimento:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# A API recusa subir se forem iguais ou tiverem menos de 32 caracteres. Trocá-los
# derruba todas as sessões abertas — é o botão de emergência se um token vazar.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# `false` porque web e API são servidos pela mesma origem. Só vira `true` se um
# dia a API ganhar host próprio.
COOKIE_CROSS_SITE=false

# ── E-mail ───────────────────────────────────────────────────────────────────
# `console` apenas escreve o e-mail no log do container, com o link dentro —
# serve para validar o fluxo de convite sem depender de domínio verificado.
# Troque para `resend` quando quiser envio real.
MAIL_TRANSPORT=console
RESEND_API_KEY=
MAIL_FROM=Normatiza <onboarding@resend.dev>

# Obrigatória se MAIL_TRANSPORT=resend e NODE_ENV != production: sem ela nada é
# enviado. Em produção a lista não se aplica.
MAIL_ALLOWLIST=

# ── Aplicação ────────────────────────────────────────────────────────────────
# Raiz pública do painel. É daqui que saem os links dos e-mails de convite e de
# recuperação de senha — apontar errado gera link que não abre.
APP_URL=https://normatiza.alanaugusto.dev
