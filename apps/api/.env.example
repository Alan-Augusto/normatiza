# Ambiente
NODE_ENV=development

# Banco de dados — Postgres no Neon (branch `develop` para desenvolvimento)
DATABASE_URL="postgresql://user:password@ep-xxxxx.region.aws.neon.tech/normatiza_db?sslmode=require"

# Banco de dados de teste — branch dedicada no Neon, NUNCA a mesma do desenvolvimento.
# A suíte e2e trunca todas as tabelas entre os testes; apontar para o banco de
# desenvolvimento apaga os dados de trabalho.
TEST_DATABASE_URL="postgresql://user:password@ep-yyyyy.region.aws.neon.tech/normatiza_db?sslmode=require"

# Segredos de sessão — gerar por ambiente com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="troque-me"
JWT_REFRESH_SECRET="troque-me-tambem"

# Tempos de vida dos tokens — ver docs/backend/autenticacao.md §3
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── E-mail ────────────────────────────────────────────────────────────────────
# `console` imprime o e-mail no log, com o link, e NÃO ENVIA NADA. É o padrão.
#
# Trocar para `resend` só quando quiser envio de verdade — e, fora de produção,
# a MAIL_ALLOWLIST passa a ser obrigatória: o seed e o elenco de testes usam
# endereços de domínios que não existem (marcos@brf.com, josue@normatiza.com), e
# disparar para eles queima a reputação do domínio remetente com hard bounces.
MAIL_TRANSPORT=console

RESEND_API_KEY=""
MAIL_FROM="Normatiza <onboarding@resend.dev>"

# Quem pode receber de verdade fora de produção. Vírgula separa.
MAIL_ALLOWLIST=""

# Raiz do painel web — monta os links dos e-mails.
APP_URL="http://localhost:8080"

# Porta da API
PORT=3000

# ── Seed de desenvolvimento ──────────────────────────────────────────────────
# A senha de todo o elenco (docs/produto/01 §2). Nunca commite a sua.
SEED_PASSWORD=troque-esta-senha
# SEED_RESET=1 apaga TODOS os usuários antes de semear. Opt-in explícito:
# sem ele, o seed só completa o que falta e não derruba nada.
# SEED_RESET=1
