datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // O endpoint `-pooler` do Neon é um pgbouncer em modo transaction, e ele não
  // sustenta os advisory locks que `prisma migrate` usa para serializar as
  // migrações — elas travam ou falham por lá. `directUrl` é o mesmo banco sem
  // o pooler (a URL sem o sufixo `-pooler` no host): a aplicação continua
  // usando o pool, e só as migrações vão pela conexão direta.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// Regras de negócio: docs/produto/01_papeis_e_permissoes.md e 04_modelo_de_dados.md
// ─────────────────────────────────────────────────────────────────────────────

/// Papel **no vínculo** — sempre "…nesta empresa, desta conta". O "lado"
/// (RoleSide) é derivado do papel, não uma coluna: é função pura, vive em
/// @normatiza/shared e não pode divergir entre app e banco.
///
/// O Admin do Sistema não está aqui: ele é a plataforma, tem escopo global e
/// vive em `PlatformAdmin`. Um papel de vínculo obrigaria a pendurá-lo numa
/// empresa de uma consultoria cliente.
enum Role {
  LEAD_ENGINEER
  CONSULTANT_ENGINEER
  TECHNICIAN
  MANAGER
  CLIENT_ENGINEER
  DIRECTOR
  EXECUTOR
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum RegistryType {
  CREA
  CFT
}

enum ExecutorType {
  INTERNAL
  THIRD_PARTY
}

/// Qual esquema produziu o `passwordHash` do usuário. `LEGACY_SHA256` existe
/// apenas para o intervalo entre a migração e o primeiro login de cada pessoa:
/// verificado uma vez, o hash é reescrito em Argon2id e o algoritmo muda (D3).
enum PasswordAlgo {
  ARGON2ID
  LEGACY_SHA256
}

/// Regra de negócio, não de interface: um arquivo `CONSULTANCY_ONLY` não pode
/// aparecer em resposta nenhuma para papel do lado cliente (docs/produto/04 §8).
enum FileVisibility {
  CONSULTANCY_ONLY
  CLIENT_VISIBLE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

// ─────────────────────────────────────────────────────────────────────────────
// Conta e identidade
// ─────────────────────────────────────────────────────────────────────────────

/// A consultoria assinante. Unidade de faturamento e limite absoluto de
/// isolamento: nada atravessa contas, em nenhuma hipótese.
model Account {
  id       String        @id @default(cuid())
  name     String
  document String        @unique
  status   AccountStatus @default(ACTIVE)

  /// O Engenheiro Responsável. Opcional na coluna porque a conta nasce antes do
  /// primeiro usuário existir — a obrigatoriedade é do fluxo de criação, não do banco.
  ownerUserId String? @unique
  owner       User?   @relation("AccountOwner", fields: [ownerUserId], references: [id])

  users        User[]         @relation("AccountUsers")
  companies    Company[]
  groups       CompanyGroup[]
  files        FileAsset[]
  memberships  Membership[]
  invitations  Invitation[]
  machineTypes MachineType[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("accounts")
}

/// A pessoa. Um login, independente de quantos papéis tenha.
model User {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation("AccountUsers", fields: [accountId], references: [id])

  name  String
  email String
  phone String?

  // Perfil profissional — apenas para engenheiros e técnicos
  registryType   RegistryType?
  registryNumber String?
  jobTitle       String?

  // ── Credenciais ────────────────────────────────────────────────────────────
  /// Nulo enquanto o usuário está `INVITED`: quem convida cria o acesso, o
  /// convidado define a senha pelo link.
  passwordHash       String?
  passwordAlgo       PasswordAlgo?
  /// Salt de 32 bytes do sistema legado. Só faz sentido com `LEGACY_SHA256`, e
  /// é apagado no mesmo ato em que a senha é reescrita em Argon2id.
  legacyPasswordSalt String?
  emailConfirmedAt   DateTime?
  lastAccessAt       DateTime?

  // ── Ciclo de vida ──────────────────────────────────────────────────────────
  status     UserStatus @default(INVITED)
  disabledAt DateTime?

  /// A aresta da árvore de convites. Não determina propriedade de dados — tudo
  /// pertence à conta. Serve para calcular o teto de escopo e a sucessão.
  invitedByUserId String?
  invitedBy       User?   @relation("InviteTree", fields: [invitedByUserId], references: [id])
  invitees        User[]  @relation("InviteTree")

  /// Quem herdou seu escopo no desligamento. Revogação exige sucessão.
  succeededByUserId String?
  succeededBy       User?   @relation("Succession", fields: [succeededByUserId], references: [id])
  succeeded         User[]  @relation("Succession")

  memberships     Membership[]
  refreshTokens   RefreshToken[]
  passwordResets  PasswordResetToken[]
  invitation      Invitation?          @relation("InvitedUser")
  sentInvitations Invitation[]         @relation("InvitationAuthor")
  ownedAccount    Account?             @relation("AccountOwner")
  platformAdmin   PlatformAdmin?       @relation("PlatformAdminUser")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  /// O e-mail é único **dentro da conta**, não globalmente: a mesma pessoa
  /// atendendo duas consultorias tem dois logins, um por conta (D11).
  @@unique([accountId, email])
  /// Existe para que `Membership` referencie (userId, accountId) em conjunto —
  /// é o que torna impossível, no banco, um vínculo atravessar contas.
  @@unique([id, accountId])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// Admin da Plataforma — o Contexto 0
// ─────────────────────────────────────────────────────────────────────────────

/// Acesso ao backoffice da plataforma, sobreposto ao login que a pessoa já tem.
///
/// `userId` aponta para **qualquer** usuário, de qualquer conta: quem é dono da
/// plataforma normalmente também é Engenheiro Responsável de uma consultoria, e
/// obrigá-lo a um segundo e-mail seria atrito sem ganho. Uma conta dedicada à
/// plataforma continua possível para quem não pertence a consultoria nenhuma.
///
/// É tabela, e não um booleano no `User`, por causa das três colunas abaixo:
/// um booleano responde "é admin?", isto responde "quem o tornou admin, quando,
/// e quem revogou" — e a segunda pergunta não se reconstrói depois.
model PlatformAdmin {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("PlatformAdminUser", fields: [userId], references: [id])

  /// Nulo apenas no primeiro admin, criado por linha de comando: não havia
  /// ninguém para conceder.
  grantedByUserId String?
  grantedAt       DateTime @default(now())

  /// Revogação preserva o histórico. Apagar a linha apagaria o fato de o acesso
  /// ter existido — que é justamente o que uma auditoria procura.
  revokedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_admins")
}

// ─────────────────────────────────────────────────────────────────────────────
// Empresa
// Regras: docs/produto/03_navegacao_e_telas.md §3.2 e 04_modelo_de_dados.md §2
// ─────────────────────────────────────────────────────────────────────────────

/// Agrupa empresas do mesmo cliente **só para relatório da consultoria**. Não
/// concede acesso: pertencer ao grupo "BRF" não faz ninguém enxergar a Seara.
model CompanyGroup {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  name           String
  /// `name` sem acento, sem maiúscula e sem espaço sobrando. É por ele que
  /// "Grupo BRF" e "grupo brf" são o mesmo grupo — e que um nome repetido é
  /// reaproveitado em vez de duplicado.
  normalizedName String

  companies Company[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  @@unique([accountId, normalizedName])
  @@map("company_groups")
}

model Company {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  /// Relação simples, e não composta com `accountId` como em `Membership`: o
  /// Prisma não aceita relação opcional sobre chave com parte obrigatória. Que
  /// o grupo seja da mesma conta é conferido pelo serviço.
  groupId String?
  group   CompanyGroup? @relation(fields: [groupId], references: [id])

  // ── Identificação ──────────────────────────────────────────────────────────
  corporateName     String
  tradeName         String
  /// O trecho legível da URL do Contexto 2 (`/app/empresas/brf-toledo`). Nasce
  /// do nome fantasia e muda com ele; o anterior vira `CompanySlugAlias`.
  /// docs/produto/03 §4.
  slug              String
  /// CNPJ **só com dígitos**. A máscara é apresentação.
  document          String
  stateRegistration String?

  // ── Contato técnico — pessoa livre, não precisa ter login ─────────────────
  contactName   String
  contactRole   String?
  contactEmail  String
  contactPhone  String?
  contactMobile String?

  // ── Endereço — obrigatório: vai impresso no laudo ─────────────────────────
  zipCode       String
  street        String
  addressNumber String
  complement    String?
  district      String
  city          String
  state         String

  // ── Metadados da consultoria — nunca chegam ao lado cliente ───────────────
  externalCode String?
  notes        String?

  logoFileId String?    @unique
  logo       FileAsset? @relation("CompanyLogo", fields: [logoFileId], references: [id])

  /// Único status **gravado**, porque é o único que alguém decide. Os demais
  /// (em implantação, aguardando Gestor, ativa) são derivados dos vínculos de
  /// Gestor — o convite expira por tempo, sem evento, e um status gravado
  /// mentiria até a próxima escrita. docs/produto/04 §2.
  deactivatedAt       DateTime?
  deactivatedByUserId String?

  /// O último número de equipamento dado nesta empresa — o próximo é `+1`.
  /// Incrementado na mesma transação que cria o equipamento, e nunca
  /// decrementado: um código excluído não volta a existir (docs/produto/03 §4.2).
  equipmentSequence Int @default(0)

  memberships Membership[]
  files       FileAsset[]        @relation("CompanyFiles")
  slugAliases CompanySlugAlias[]
  sectors     Sector[]
  equipments  Equipment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  @@unique([accountId, document])
  @@unique([accountId, slug])
  @@unique([id, accountId])
  @@map("companies")
}

/// Um slug que a empresa já teve. O link antigo — favorito, e-mail — continua
/// abrindo a empresa depois de um renome, e o endereço nunca passa a outra
/// empresa. Único na conta **também contra os slugs vigentes**, o que o serviço
/// confere: o banco não tem restrição que atravesse as duas tabelas.
model CompanySlugAlias {
  id        String @id @default(cuid())
  accountId String

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  slug String

  createdAt DateTime @default(now())

  @@unique([accountId, slug])
  @@index([companyId])
  @@map("company_slug_aliases")
}

// ─────────────────────────────────────────────────────────────────────────────
// O vínculo: onde mora a permissão
// ─────────────────────────────────────────────────────────────────────────────

/// Um usuário × uma empresa × um ou mais papéis. A permissão efetiva é a união
/// dos papéis do vínculo — por isso `roles` é lista, e não coluna única.
model Membership {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  userId String
  /// A chave composta (userId, accountId) é deliberada: o banco recusa um
  /// vínculo cujo usuário pertença a outra conta.
  user   User   @relation(fields: [userId, accountId], references: [id, accountId])

  companyId String
  company   Company @relation(fields: [companyId, accountId], references: [id, accountId])

  roles Role[]

  executorType ExecutorType?
  /// Fornecedor do executor terceiro. Sem relação por enquanto: `Supplier` é da
  /// feature de custos e ainda não existe.
  supplierId   String?

  isActive Boolean @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  /// Um vínculo por par usuário×empresa. Papel adicional entra no array `roles`,
  /// nunca como segundo vínculo com a mesma empresa.
  @@unique([userId, companyId])
  @@index([accountId])
  @@index([companyId])
  @@map("memberships")
}

// ─────────────────────────────────────────────────────────────────────────────
// Fluxos de credencial
// ─────────────────────────────────────────────────────────────────────────────

/// O convite é a **única** porta de entrada de usuário no sistema (D15).
/// O `User` já nasce junto com o convite, em `INVITED`; aceitar o convite é
/// definir a senha, não criar cadastro.
model Invitation {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  userId String @unique
  user   User   @relation("InvitedUser", fields: [userId], references: [id])

  invitedByUserId String
  invitedBy       User   @relation("InvitationAuthor", fields: [invitedByUserId], references: [id])

  /// Escopo oferecido, congelado no ato do convite: nunca maior que o de quem
  /// convida. É snapshot — reavaliar no aceite deixaria o teto móvel.
  roles        Role[]
  companyIds   String[]
  executorType ExecutorType?

  /// Só o hash: quem lê o banco não consegue aceitar convite alheio.
  tokenHash String           @unique
  expiresAt DateTime
  status    InvitationStatus @default(PENDING)

  acceptedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId])
  @@map("invitations")
}

model PasswordResetToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  requestedIp String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Refresh token persistido — é o que torna a revogação imediata (D4).
/// O access token é stateless e curto; este é longo e revogável.
model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  /// Todos os tokens descendentes de um mesmo login. Detectado o reúso de um
  /// token já rotacionado, a **família inteira** é revogada: é roubo até prova
  /// em contrário, e a prova não vem a tempo (D7).
  familyId String

  tokenHash String   @unique
  expiresAt DateTime

  /// Marcado ao ser trocado por um novo. Um token com `usedAt` que reaparece é
  /// o sinal de reúso.
  usedAt            DateTime?
  replacedByTokenId String?
  revokedAt         DateTime?
  revokedReason     String?

  userAgent String?
  ipAddress String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// Trilha de auditoria
// ─────────────────────────────────────────────────────────────────────────────

/// Registro técnico de quem fez o quê, quando e de onde.
///
/// É o registro **técnico**, não a narrativa: a linha do tempo legível pelo
/// usuário é o `TimelineEvent`, que entra com as features de negócio. São coisas
/// diferentes e não devem ser fundidas.
model AuditLog {
  id String @id @default(cuid())

  /// Nulo em tentativa de login com e-mail que não existe: não há conta a que
  /// atribuir o evento, e é justamente esse evento que se quer registrar.
  accountId   String?
  actorUserId String?

  action     String
  entityType String
  entityId   String?

  /// Só o que a ação mudou. Credencial nunca entra aqui — nem antes, nem depois.
  before Json?
  after  Json?
  reason String?

  ipAddress String?
  userAgent String?

  occurredAt DateTime @default(now())

  @@index([accountId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Arquivos
// Regras: docs/produto/05_regras_transversais.md §4
// ─────────────────────────────────────────────────────────────────────────────

/// O registro de um arquivo no storage. Os bytes moram no bucket; aqui mora de
/// quem ele é, quem o enviou e quem pode vê-lo.
///
/// Nunca apagado: trocar o logo cria outro `FileAsset`, porque o laudo emitido
/// no ano passado continua apontando para o antigo.
model FileAsset {
  id        String  @id @default(cuid())
  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  companyId String?
  company   Company? @relation("CompanyFiles", fields: [companyId], references: [id])

  equipmentId String?
  equipment   Equipment? @relation("EquipmentFiles", fields: [equipmentId], references: [id], onDelete: SetNull)

  /// As fotos que a análise tirou. Descartar o rascunho as remove antes — a
  /// chave sem `onDelete` recusa apagar a análise que ainda tem arquivo.
  analysisId String?
  analysis   Analysis? @relation("AnalysisFiles", fields: [analysisId], references: [id], onDelete: Restrict)

  title       String?
  description String?
  /// Para que o arquivo existe: `COMPANY_LOGO`, e as categorias que vierem com
  /// fotos e documentos.
  category    String?

  /// Caminho no bucket, sempre prefixado por `accounts/{accountId}/`. Escrito
  /// pelo servidor, nunca por quem envia.
  storageKey String @unique
  /// Lido dos bytes, não declarado pelo navegador.
  mimeType   String
  sizeBytes  Int

  thumbnailKey String?
  visibility   FileVisibility
  expiresAt    DateTime?

  capturedAt       DateTime?
  capturedByUserId String?

  logoOf      Company?   @relation("CompanyLogo")
  mainPhotoOf Equipment? @relation("EquipmentMainPhoto")
  frontOf     Analysis?  @relation("AnalysisFrontPhoto")
  leftSideOf  Analysis?  @relation("AnalysisLeftSidePhoto")
  rightSideOf Analysis?  @relation("AnalysisRightSidePhoto")
  rearOf      Analysis?  @relation("AnalysisRearPhoto")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  @@index([accountId])
  @@index([companyId])
  @@index([equipmentId])
  @@index([analysisId])
  @@map("file_assets")
}

// ─────────────────────────────────────────────────────────────────────────────
// Inventário da planta
// Regras: docs/produto/03_navegacao_e_telas.md §4.2 e §4.3, 04_modelo_de_dados.md §2, §3 e §7
// ─────────────────────────────────────────────────────────────────────────────

/// As fontes de energia da máquina — o que se isola antes de uma intervenção.
enum EnergySource {
  ELECTRIC
  PNEUMATIC
  HYDRAULIC
  MECHANICAL
  RADIOACTIVE
}

/// Organização física da planta. O nome é comparado sem acento, caixa nem
/// espaço sobrando (`normalizedName`): criar "usinagem " onde já existe
/// "Usinagem" devolve o existente — o defeito que o legado acumulou.
model Sector {
  id        String  @id @default(cuid())
  accountId String
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name              String
  normalizedName    String
  description       String?
  responsibleUserId String?

  equipments Equipment[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  @@unique([companyId, normalizedName])
  @@index([accountId])
  @@map("sectors")
}

/// Catálogo de tipos de máquina. `accountId` nulo = global, semeado pela
/// plataforma; preenchido = acrescentado por aquela consultoria. Quem consulta
/// sempre une os dois conjuntos.
model MachineType {
  id        String   @id @default(cuid())
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id])

  name           String
  normalizedName String

  equipments Equipment[]

  createdAt       DateTime @default(now())
  createdByUserId String?

  @@unique([accountId, normalizedName])
  @@map("machine_types")
}

/// O ativo — o eixo do sistema (docs/produto/00 §2.2). Só a identidade da
/// máquina mora aqui; o que se mede na vistoria é da ficha técnica da análise.
model Equipment {
  id        String  @id @default(cuid())
  accountId String
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// `EQ-0001`: sequencial por empresa, imutável, nunca reaproveitado. É a
  /// chave da URL e da API (`/companies/:companyId/equipments/:code`).
  code String

  name             String
  machineTypeId    String?
  machineType      MachineType? @relation(fields: [machineTypeId], references: [id])
  model            String?
  manufacturerName String?
  serialNumber     String?
  manufactureYear  Int?
  /// A TAG do cliente. Opcional, mas única na empresa quando preenchida — o
  /// Postgres trata nulos como distintos, então o índice não barra os vazios.
  tag              String?
  patrimonyCode    String?

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id])

  // ── Ficha do ativo — características da máquina, não medidas da vistoria ──
  // docs/produto/04 §3. A análise concluída guarda uma cópia disto.
  purpose              String?
  productiveCapacity   String?
  powerKw              Float?
  controlStations      Int?
  exposedOperators     Int?
  energySources        EnergySource[] @default([])
  processDescription   String?
  commonInterventions  String?
  otherInfo            String?
  heightMm             Int?
  widthMm              Int?
  depthMm              Int?
  weightKg             Float?
  /// CNPJ do fabricante, só dígitos. O nome é `manufacturerName`, identidade.
  manufacturerDocument String?
  manufacturerRegistry String?
  manufacturerAddress  String?
  manufacturerCity     String?
  /// CEP, só dígitos.
  manufacturerZipCode  String?

  mainPhotoFileId String?     @unique
  mainPhoto       FileAsset?  @relation("EquipmentMainPhoto", fields: [mainPhotoFileId], references: [id])
  files           FileAsset[] @relation("EquipmentFiles")

  analyses Analysis[]

  /// Preenchido = fora do inventário, em modo leitura. Só a desativação é
  /// gravada; conformidade, pior HRN e pontos nascem das análises.
  deactivatedAt       DateTime?
  deactivatedByUserId String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  @@unique([companyId, code])
  @@unique([companyId, tag])
  @@index([accountId])
  @@index([sectorId])
  @@map("equipments")
}

// ─────────────────────────────────────────────────────────────────────────────
// Catálogos da análise — globais, mantidos pela plataforma (docs/produto/04 §7).
// Vieram do legado (docs/migracao §7): `legacy_refs` guarda de onde.
// ─────────────────────────────────────────────────────────────────────────────

/// Capítulo ou anexo da norma: "12.5 Sistemas de segurança", "Anexo VIII -
/// Prensas e similares". A seleção de normas descumpridas agrupa por aqui.
model StandardSection {
  id    String @id @default(cuid())
  /// Sob qual norma. Hoje só "NR-12"; o eixo existe para outra norma conviver.
  norm  String @default("NR-12")
  name  String
  /// Os capítulos 12.x pela numeração, depois os anexos pela numeração romana.
  order Int

  standards Standard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("standard_sections")
}

/// Item da norma — o que a análise aponta como descumprido.
model Standard {
  id        String          @id @default(cuid())
  norm      String          @default("NR-12")
  sectionId String
  section   StandardSection @relation(fields: [sectionId], references: [id])

  /// "12.38.1". Não é único: os anexos recomeçam a numeração ("1.1" existe em
  /// vários), e o legado tem códigos tortos que os laudos já imprimiram.
  itemCode String
  text     String
  /// Item que saiu da norma continua existindo: há análise apontando para ele.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sectionId])
  @@map("standards")
}

/// Tipo de perigo: mecânico, elétrico, térmico… Agrupa origens e consequências.
model HazardType {
  id    String @id @default(cuid())
  name  String
  order Int

  origins      HazardOrigin[]
  consequences HazardConsequence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hazard_types")
}

/// O nome se repete entre tipos ("Queimadura" é elétrica e térmica), e é certo.
model HazardOrigin {
  id           String     @id @default(cuid())
  hazardTypeId String
  hazardType   HazardType @relation(fields: [hazardTypeId], references: [id])
  name         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hazardTypeId])
  @@map("hazard_origins")
}

model HazardConsequence {
  id           String     @id @default(cuid())
  hazardTypeId String
  hazardType   HazardType @relation(fields: [hazardTypeId], references: [id])
  name         String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([hazardTypeId])
  @@map("hazard_consequences")
}

/// Tipo de proteção: fixa, móvel, sensores de segurança… Agrupa os dispositivos.
model ProtectionType {
  id    String @id @default(cuid())
  name  String
  order Int

  protections Protection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("protection_types")
}

/// O dispositivo — o que o ponto de risco marca como já instalado.
model Protection {
  id               String         @id @default(cuid())
  protectionTypeId String
  protectionType   ProtectionType @relation(fields: [protectionTypeId], references: [id])
  name             String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([protectionTypeId])
  @@map("protections")
}

/// A tabela do HRN, versionada (docs/produto/04 §7, 05 §1). A análise guarda a
/// versão que usou; mudar um peso é criar versão nova, nunca editar esta.
/// Fatores e faixas são `@normatiza/shared` (`HrnTable`), gravados como estão.
model HrnTableVersion {
  id            String    @id
  label         String
  effectiveFrom DateTime
  /// Nulo = vigente.
  effectiveTo   DateTime?
  factors       Json
  levels        Json

  analyses Analysis[]

  createdAt DateTime @default(now())

  @@map("hrn_table_versions")
}

/// De onde veio cada registro migrado (docs/migracao §1): `entity` é a tabela
/// do legado, `legacyId` o id lá, `newId` o id aqui. O legado é um banco só, e
/// o id de uma tabela não se repete entre contas.
model LegacyRef {
  entity   String
  legacyId Int
  newId    String

  createdAt DateTime @default(now())

  @@id([entity, legacyId])
  @@index([entity, newId])
  @@map("legacy_refs")
}

// ─────────────────────────────────────────────────────────────────────────────
// A análise de risco (docs/produto/03 §5.2, 04 §4)
// ─────────────────────────────────────────────────────────────────────────────

enum AnalysisStatus {
  DRAFT
  CONCLUDED
}

/// A vistoria de uma máquina. Nasce rascunho, visto só pela consultoria; ao
/// concluir, congela. Um rascunho por equipamento — índice parcial na migração,
/// que o Prisma não sabe declarar.
model Analysis {
  id          String    @id @default(cuid())
  accountId   String
  companyId   String
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])

  /// Análise 1, 2, 3… do equipamento: cada volta à máquina é uma nova.
  number               Int
  /// Correção de análise concluída: mesmo número, revisão seguinte.
  revision             Int            @default(1)
  supersedesAnalysisId String?
  /// Sob qual norma. Hoje só "NR-12", sem aparecer em tela.
  norm                 String         @default("NR-12")
  status               AnalysisStatus @default(DRAFT)

  startedAt   DateTime  @default(now())
  concludedAt DateTime?
  frozenAt    DateTime?

  /// Quem levantou em campo: quem abriu, trocável por outra pessoa da consultoria.
  fieldTechnicianUserId     String?
  /// Quem assina — escolhido ao concluir, com a ART.
  responsibleEngineerUserId String?
  artNumber                 String?

  /// A tabela com que o HRN foi calculado: é o que torna o laudo reproduzível.
  hrnTableVersionId String
  hrnTableVersion   HrnTableVersion @relation(fields: [hrnTableVersionId], references: [id])

  // ── Medido na vistoria ─────────────────────────────────────────────────────
  cycleTimeSec         Float?
  activationTimeSec    Float?
  emergencyStopTimeSec Float?
  shiftRegime          String?

  // As seis perguntas de gestão de segurança; nulo = ainda sem resposta.
  maintenancePlannedByQualifiedProfessional Boolean?
  maintenanceRecorded                       Boolean?
  maintenanceRecordsAvailable               Boolean?
  hasInstructionManual                      Boolean?
  hasWorkAndSafetyProcedures                Boolean?
  workersTrained                            Boolean?

  frontPhotoFileId     String?    @unique
  frontPhoto           FileAsset? @relation("AnalysisFrontPhoto", fields: [frontPhotoFileId], references: [id])
  leftSidePhotoFileId  String?    @unique
  leftSidePhoto        FileAsset? @relation("AnalysisLeftSidePhoto", fields: [leftSidePhotoFileId], references: [id])
  rightSidePhotoFileId String?    @unique
  rightSidePhoto       FileAsset? @relation("AnalysisRightSidePhoto", fields: [rightSidePhotoFileId], references: [id])
  rearPhotoFileId      String?    @unique
  rearPhoto            FileAsset? @relation("AnalysisRearPhoto", fields: [rearPhotoFileId], references: [id])

  files FileAsset[] @relation("AnalysisFiles")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdByUserId String?

  @@unique([equipmentId, number, revision])
  @@index([accountId])
  @@index([companyId])
  @@map("analyses")
}
